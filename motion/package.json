{
  "name": "sapienza-motion",
  "version": "0.1.0",
  "private": true,
  "description": "Peças de motion (vídeo animado on-brand) da Margot Editora — 4 presets Remotion + serviço de render.",
  "scripts": {
    "copy-assets": "tsx scripts/copy-assets.ts",
    "studio": "pnpm copy-assets && remotion studio src/index.ts",
    "sample": "pnpm copy-assets && tsx scripts/sample.ts",
    "render-worker": "pnpm copy-assets && tsx scripts/worker.ts",
    "clip-worker": "pnpm copy-assets && tsx scripts/clip-worker.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/fonts": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "postgres": "^3.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
