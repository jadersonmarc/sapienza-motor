{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../*"]
    }
  },
  "include": [
    "src",
    "scripts/copy-assets.ts",
    "scripts/sample.ts",
    "scripts/still.ts",
    "remotion.config.ts",
    "../lib/content/motion-types.ts",
    "../lib/brand/tokens.ts"
  ]
}
