# Serviço do CLIPPER (Clipes Inteligentes). Base do motion-worker (Chromium headless
# + Remotion) MAIS: ffmpeg CLI (probe/extração de áudio) e yt-dlp (ingestão por URL).
# Jobs longos → mais memória e timeout maiores (ver envs do clip-worker).
#
# IMPORTANTE: build context = RAIZ do repo do motor (motion/ importa ../lib e ../assets).
# No Coolify: Build Pack = Dockerfile, Dockerfile = motion/Dockerfile.clip.
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates fonts-liberation wget \
  libnss3 libdbus-1-3 libatk1.0-0 libgbm-dev libasound2 libxrandr2 \
  libxkbcommon-dev libxfixes3 libxcomposite1 libxdamage1 libatk-bridge2.0-0 \
  libpango-1.0-0 libcairo2 libcups2 \
  ffmpeg \
  && rm -rf /var/lib/apt/lists/*

# yt-dlp: binário standalone mais recente (o pacote apt do Debian atrasa e quebra
# quando as plataformas mudam — risco citado na SPEC). Sem dependência de python.
RUN wget -q https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux \
    -O /usr/local/bin/yt-dlp && chmod a+rx /usr/local/bin/yt-dlp

RUN corepack enable

WORKDIR /app
COPY . /app
RUN pnpm install --frozen-lockfile

WORKDIR /app/motion
RUN pnpm install --frozen-lockfile
RUN pnpm copy-assets
RUN pnpm exec remotion browser ensure

ENV PORT=3300
EXPOSE 3300

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3300/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

# Sobe o clip-worker HTTP: POST /trigger (x-webhook-secret) roda o scan; GET /health.
CMD ["pnpm", "clip-worker"]
